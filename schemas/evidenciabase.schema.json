{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinicaneurobee.com.br/neurodados/schemas/evidenciabase.schema.json",
  "title": "Registro da EvidenciaBase",
  "description": "Uma publicação (estudo, revisão, diretriz, consenso ou documento oficial) com os metadados e um resumo escrito pela equipe. O texto original não é reproduzido.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "slug", "base", "nome", "categoria", "publicacao", "temas", "definicao", "afirmacoes", "limitacoes", "fontes", "estado", "revisao", "versao", "criado_em", "atualizado_em", "historico"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^evidenciabase\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "base": { "const": "evidenciabase" },
    "nome": { "type": "string", "minLength": 5, "maxLength": 200, "description": "Título em português, escrito pela equipe, que diz do que trata a publicação." },
    "categoria": { "enum": ["revisao_sistematica", "meta_analise", "revisao_narrativa", "diretriz_clinica", "consenso", "estudo_populacional", "estudo_primario", "documento_oficial"] },
    "publicacao": {
      "type": "object",
      "additionalProperties": false,
      "required": ["titulo_original", "autores", "ano", "veiculo", "url"],
      "properties": {
        "titulo_original": { "type": "string", "minLength": 3, "maxLength": 400 },
        "autores": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2, "maxLength": 200 } },
        "ano": { "type": "integer", "minimum": 1900, "maximum": 2100 },
        "veiculo": { "type": "string", "minLength": 2, "maxLength": 300, "description": "Revista, com volume e páginas, ou instituição." },
        "doi": { "type": "string", "pattern": "^10\\.[0-9]{4,9}/\\S+$" },
        "url": { "type": "string", "pattern": "^https?://" },
        "acesso_aberto": { "type": "boolean" },
        "idioma": { "type": "string", "maxLength": 20 }
      }
    },
    "temas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["tea", "tdah", "aprendizagem", "deficiencia_intelectual", "linguagem", "desenvolvimento_infantil", "funcoes_executivas", "avaliacao", "rastreamento", "intervencoes", "prevalencia", "saude_publica"] }
    },
    "populacao": { "type": "string", "maxLength": 600 },
    "metodo": { "type": "string", "maxLength": 800 },
    "definicao": { "type": "string", "minLength": 40, "maxLength": 600, "description": "O resumo da publicação em uma ou duas frases, escrito pela equipe." },
    "descricao": { "type": "string", "maxLength": 3000 },
    "afirmacoes": { "type": "array", "minItems": 1, "items": { "$ref": "comum.schema.json#/$defs/afirmacao" }, "description": "Os principais resultados, cada um com a fonte." },
    "relacionados": { "type": "array", "items": { "$ref": "comum.schema.json#/$defs/relacionamento" } },
    "limitacoes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10, "maxLength": 500 } },
    "fontes": { "type": "array", "minItems": 1, "items": { "$ref": "comum.schema.json#/$defs/fonte" } },
    "estado": { "enum": ["rascunho", "publicado", "desatualizado", "arquivado"] },
    "revisao": { "$ref": "comum.schema.json#/$defs/revisao" },
    "versao": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "criado_em": { "$ref": "comum.schema.json#/$defs/data" },
    "atualizado_em": { "$ref": "comum.schema.json#/$defs/data" },
    "historico": { "type": "array", "minItems": 1, "items": { "$ref": "comum.schema.json#/$defs/historico" } }
  }
}
